# --- OpenAI (only read by the backend, never exposed to the frontend) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Reasoning sent on every Responses API call.
# OPENAI_REASONING_EFFORT: none | minimal | low | medium | high | xhigh | max  (default: high)
# OPENAI_REASONING_MODE:   standard | pro                                        (default: standard)
OPENAI_REASONING_EFFORT=high
OPENAI_REASONING_MODE=standard

# --- Ports ---
BACKEND_PORT=8000
FRONTEND_PORT=5173

# --- Optional settings (defaults shown) ---
# Comma-separated list of allowed frontend origins (never "*" by default)
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Transcript language preference order (manual before automatic within each language)
# TRANSCRIPT_LANGUAGES=es,en
# Where SQLite DB and generated documents are stored
# DATA_DIR=../data
# Providers: "youtube" | "fixture"  and  "openai" | "fake" (fake = offline development)
# TRANSCRIPT_PROVIDER=youtube
# AI_PROVIDER=openai
# Run the verification stage (D) of the AI pipeline
# AI_ENABLE_VERIFICATION=true
# Maximum number of distinct videos in a multi-URL batch
# MAX_VIDEOS_PER_BATCH=20

# --- YouTube transcript proxy (optional, backend only) ---
# Cloud hosts (Render, AWS...) usually get RequestBlocked/IpBlocked from YouTube.
# "none" = direct connection (local default) | "webshare" = Webshare residential rotating proxy.
# Only transcript requests to YouTube use the proxy; OpenAI never does.
YOUTUBE_PROXY_PROVIDER=none
# Required when YOUTUBE_PROXY_PROVIDER=webshare. Never commit real values.
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=
# Optional comma-separated country codes, e.g. es,de,fr
WEBSHARE_PROXY_LOCATIONS=
